<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: jump straight into a new entry. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_countdown"
        android:enabled="true"
        android:icon="@drawable/shortcut_countdown"
        android:shortcutShortLabel="@string/shortcut_countdown"
        android:shortcutLongLabel="@string/shortcut_countdown">
        <intent
            android:action="io.github.devlueks.daysy.NEW_COUNTDOWN"
            android:targetPackage="io.github.devlueks.daysy"
            android:targetClass="io.github.devlueks.daysy.ShortcutActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="new_since"
        android:enabled="true"
        android:icon="@drawable/shortcut_countup"
        android:shortcutShortLabel="@string/shortcut_since"
        android:shortcutLongLabel="@string/shortcut_since">
        <intent
            android:action="io.github.devlueks.daysy.NEW_COUNTUP"
            android:targetPackage="io.github.devlueks.daysy"
            android:targetClass="io.github.devlueks.daysy.ShortcutActivity" />
    </shortcut>
</shortcuts>
